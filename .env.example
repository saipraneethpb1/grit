# Create a project at https://supabase.com and paste values from
# Project Settings → API.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required for Google Play / App Store submission — public HTTPS URLs.
# GitHub Pages serves docs/privacy.html and docs/terms.html (npm run build:legal):
# https://saipraneethpb1.github.io/grit/privacy.html and /terms.html
# See PLAY_STORE.md.

EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
