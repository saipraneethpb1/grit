# Create a project at https://supabase.com and paste values from
# Project Settings → API.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required for Google Play / App Store submission — public HTTPS URLs.
# Host legal/privacy-policy.md and legal/terms-of-service.md, or deploy
# the Expo web build (npx expo export --platform web) and use /legal/* routes.
# See PLAY_STORE.md.

EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
