# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
*.orig.*

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store

# Secrets — never commit. `.env.*` is denied by default and .env.example is
# the single opt-in, so a new .env.production or .env.staging is ignored
# without anyone having to remember to add it.
.env
.env.*
!.env.example

# Signing material and store credentials
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision
*service-account*.json
google-service-account.json
credentials.json
.easignore.local

# Signed build output
releases/
*.aab
*.apk
*.ipa

# editor / agent (not project source)
.cursor/

# typescript
*.tsbuildinfo

# reference material (not app source)
*.pdf

# testing
coverage/
