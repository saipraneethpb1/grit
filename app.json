{
  "expo": {
    "name": "Grit",
    "slug": "grit",
    "version": "1.0.0",
    "description": "An anatomy-aware strength training planner and workout log.",
    "orientation": "portrait",
    "icon": "./assets/images/grit-icon.png",
    "scheme": "grit",
    "userInterfaceStyle": "dark",
    "primaryColor": "#9184d9",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.praneeth.grit",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.praneeth.grit",
      "versionCode": 1,
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#161826",
        "foregroundImage": "./assets/images/grit-adaptive-foreground.png",
        "monochromeImage": "./assets/images/grit-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/grit-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/grit-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#161826",
          "dark": {
            "image": "./assets/images/grit-icon.png",
            "backgroundColor": "#161826"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9d69c80c-c277-4b6f-a42a-6070b54d00aa"
      }
    },
    "owner": "saipraneethpb"
  }
}
